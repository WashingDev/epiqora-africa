NODE_ENV=development
APP_NAME=OutbreakWatch Africa
PORT=4000
API_PREFIX=api/v1

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=outbreakwatch_app
DB_PASSWORD=CHANGE_THIS_LOCALLY
DB_DATABASE=outbreakwatch

CORS_ORIGIN=http://localhost:3000

KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=epiqora
KEYCLOAK_CLIENT_ID=epiqora-api

KEYCLOAK_ISSUER=http://localhost:8180/realms/epiqora
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/epiqora/protocol/openid-connect/certs

# Expected audience in Keycloak access tokens
KEYCLOAK_AUDIENCE=epiqora-api
